# Copy to rolodex/.env — only set keys you have.
# Runtime drops cards whose keys are missing. Local always stays.

# --- Rolodex proxy ---
ROLODEX_PORT=4000
ROLODEX_UPSTREAM_PORT=4001
ROLODEX_MASTER_KEY=sk-rolodex
# Optional: ROLODEX_LANES=lane/local,lane/fast,lane/smart,lane/code
# Optional: ROLODEX_TIERS=local,free,trial

# --- Local OpenAI-compatible backends ---
LOCAL_DS4_BASE=http://127.0.0.1:8000/v1
LOCAL_LLAMA_BASE=http://127.0.0.1:8080/v1
LOCAL_API_KEY=local
LOCAL_MODEL_ID=glm-5.2

# --- Ongoing free tiers ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
HF_TOKEN=
VERCEL_AI_GATEWAY_TOKEN=
