# cluster.env — copy to cluster.env and fill in for YOUR two machines.
# Everything machine-specific lives here; the scripts read only from this file.
#
# Topology: NODE0 = coordinator (owns the GGUF, runs llama-server, drives decode).
#           NODE1 = worker (runs rpc-server over a fast link; reached by SSH from NODE0).
# Run all scripts ON NODE0.

# --- NODE1 (worker) reachability ---
NODE1_SSH="user@worker.example.invalid" # SSH target for NODE1 (used to start/stop the worker)
NODE1_IP="192.0.2.2"                  # example IP NODE0 uses to reach NODE1's RPC server (the FAST link, e.g. Thunderbolt bridge)
SSH_KEY="$HOME/.ssh/id_ed25519"       # SSH key for NODE1

# --- binaries (must be the SAME patched build on BOTH nodes; see patches/) ---
# Build llama.cpp with the patches in ../patches applied, GGML_METAL=ON GGML_RPC=ON GGML_BLAS=OFF.
LLAMA_BIN="$HOME/llama.cpp/build/bin"                 # on NODE0
RPC_BIN_REMOTE="\$HOME/llama.cpp/build/bin/rpc-server" # on NODE1 (note the escaped $ — expanded on NODE1)

# --- model (a single-or-sharded GGUF; point at shard 1) ---
MODEL="$HOME/models/your-model/model-00001-of-0000N.gguf"
SMOKE_1B="$HOME/models/smoke/Llama-3.2-1B-Instruct-Q4_K_M.gguf"  # optional tiny model for the RPC-link smoke

# --- ports ---
: "${RPC_PORT:=50052}"
: "${SERVE_PORT:=8080}"

# --- decode config (tuned defaults from the FINDINGS; override via env at runtime) ---
: "${KV_TYPE:=f16}"          # f16 beat q8_0 here (q8_0 per-step dequant cost > its smaller read on small MLA KV)
: "${CTX:=16384}"
: "${ARCH:=glm-dsa}"         # metadata arch key for --override-kv; change if your model's arch differs
: "${N_EXPERT_USED:=}"       # empty = model default. Set e.g. 5 for LExI (see docs/FINDINGS.md; ODD values only on some builds)
: "${SETTLE_LOAD:=2.5}"      # NODE1 1-min loadavg gate before the heavy load
: "${MIN_FREE_GB:=90}"       # NODE1 free-RAM gate before the serve load (set ~ to your per-node model half)

# --- optional: a command to (re)assert NODE1's fast-link IP before a load (leave empty if your link is stable) ---
# e.g. for a Thunderbolt bridge that drifts: "ssh $NODE1_SSH 'sudo ifconfig en6 inet 192.0.2.2 netmask 255.255.255.0'"
LINK_PIN_CMD=""
